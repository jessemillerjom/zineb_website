<!-- Hero Section -->
<section class="hero" id="home">
  <div class="hero-media">
    {%- if section.settings.background_image != blank -%}
      <img
        src="{{ section.settings.background_image | image_url: width: 1800 }}"
        srcset="{{ section.settings.background_image | image_url: width: 800 }} 800w,
                {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
                {{ section.settings.background_image | image_url: width: 1800 }} 1800w"
        sizes="100vw"
        alt="{{ section.settings.background_image.alt | default: shop.name }}"
        class="hero-bg-image"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero-bg-placeholder"></div>
    {%- endif -%}
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content container">
    <div class="hero-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero-heading">{{ section.settings.heading | default: 'Handcrafted Ceramics from the Heart' }}</h1>
      <p class="hero-subheading">{{ section.settings.subheading | default: 'Each piece shaped by hand in Brooklyn, carrying the colors of Morocco.' }}</p>
      <div class="hero-actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="btn btn-primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_url | default: '/pages/about' }}" class="btn btn-outline">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Brooklyn · Morocco · Clay"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handcrafted Ceramics from the Heart"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each piece shaped by hand in Brooklyn, carrying the colors of Morocco."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Ceramics"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
