<!-- Featured Collections -->
<section class="featured-collections section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collections-grid">
      {%- if section.blocks.size > 0 -%}
        {%- comment -%} Use manually configured blocks from the theme editor {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign col = collections[block.settings.collection] -%}
          <a href="{{ col.url | default: routes.collections_url }}" class="collection-card" {{ block.shopify_attributes }}>
            <div class="collection-card-image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | default: col.title }}" loading="lazy">
              {%- elsif col.image != blank -%}
                <img src="{{ col.image | image_url: width: 900 }}" alt="{{ col.title }}" loading="lazy">
              {%- elsif col.products.first.featured_image != blank -%}
                <img src="{{ col.products.first.featured_image | image_url: width: 900 }}" alt="{{ col.title }}" loading="lazy">
              {%- else -%}
                <div class="collection-placeholder-bg collection-placeholder-bowls"></div>
              {%- endif -%}
              <div class="collection-card-overlay"></div>
            </div>
            <div class="collection-card-content">
              <h3>{{ block.settings.title | default: col.title }}</h3>
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description }}</p>
              {%- elsif col.description != blank -%}
                <p>{{ col.description | strip_html | truncate: 80 }}</p>
              {%- endif -%}
              <span class="collection-link">Shop now →</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Auto-pull from store collections when no blocks configured yet {%- endcomment -%}
        {%- assign shown = 0 -%}
        {%- for col in collections -%}
          {%- if col.handle != 'frontpage' and shown < 3 -%}
            <a href="{{ col.url }}" class="collection-card">
              <div class="collection-card-image">
                {%- if col.image != blank -%}
                  <img src="{{ col.image | image_url: width: 900 }}" alt="{{ col.title }}" loading="lazy">
                {%- elsif col.products.first.featured_image != blank -%}
                  <img src="{{ col.products.first.featured_image | image_url: width: 900 }}" alt="{{ col.title }}" loading="lazy">
                {%- else -%}
                  <div class="collection-placeholder-bg collection-placeholder-bowls"></div>
                {%- endif -%}
                <div class="collection-card-overlay"></div>
              </div>
              <div class="collection-card-content">
                <h3>{{ col.title }}</h3>
                {%- if col.description != blank -%}<p>{{ col.description | strip_html | truncate: 80 }}</p>{%- endif -%}
                <span class="collection-link">Shop now →</span>
              </div>
            </a>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if shown == 0 -%}
          <a href="{{ routes.collections_url }}" class="collection-card">
            <div class="collection-card-image collection-placeholder-bg collection-placeholder-bowls">
              <div class="collection-card-overlay"></div>
            </div>
            <div class="collection-card-content">
              <h3>All Ceramics</h3>
              <p>Browse the full collection</p>
              <span class="collection-link">Shop now →</span>
            </div>
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the full range of handcrafted ceramics"
    }
  ],
  "presets": [
    {
      "name": "Featured Collections"
    }
  ]
}
{% endschema %}
