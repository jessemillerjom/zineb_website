<!-- Generic Page Template -->
<div class="page-generic">
  <div class="container">
    <div class="page-header">
      <h1>{{ page.title }}</h1>
    </div>
    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</div>

<style>
.page-generic { padding: 80px 0; }
.page-header { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
.page-header h1 { font-size: clamp(2rem, 4vw, 3rem); }
.page-content.rte { max-width: 720px; }
.page-content.rte p { color: var(--charcoal-lt); line-height: 1.8; margin-bottom: 20px; }
.page-content.rte h2, .page-content.rte h3 { margin-top: 40px; margin-bottom: 16px; }
.page-content.rte a { color: var(--primary); text-decoration: underline; }
.page-content.rte ul, .page-content.rte ol { padding-left: 24px; margin-bottom: 20px; }
.page-content.rte li { margin-bottom: 8px; color: var(--charcoal-lt); }
</style>
