[
  {
    "name": "theme_info",
    "theme_name": "Zineb Ceramics",
    "theme_version": "1.0.0",
    "theme_author": "Zineb",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 260,
        "step": 10,
        "default": 160,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
        "default": "Free shipping on orders over $150 · Handcrafted in Brooklyn, NY"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (Terracotta)",
        "default": "#C97D60"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary (Blue)",
        "default": "#2E5266"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Gold)",
        "default": "#F4A460"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F9F7F4"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#2C2C2C"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "pinterest_url",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "page", "label": "Page" },
          { "value": "drawer", "label": "Drawer (sidebar)" }
        ],
        "default": "page"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  }
]
