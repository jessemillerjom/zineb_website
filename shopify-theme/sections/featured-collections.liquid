<!-- Featured Collections -->
<section class="featured-collections section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collections-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a href="{{ collection.url | default: '/collections/all' }}" class="collection-card" {{ block.shopify_attributes }}>
          <div class="collection-card-image">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 900 }} 900w"
                sizes="(max-width: 768px) 100vw, 33vw"
                alt="{{ block.settings.title | default: collection.title }}"
                loading="lazy"
              >
            {%- elsif collection.image != blank -%}
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.title }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="collection-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/>
                  <path d="M7 10c0-1.5 2-3 5-3s5 1.5 5 3v8H7v-8z"/>
                </svg>
              </div>
            {%- endif -%}
            <div class="collection-card-overlay"></div>
          </div>
          <div class="collection-card-content">
            <h3>{{ block.settings.title | default: collection.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- elsif collection.description != blank -%}
              <p>{{ collection.description | strip_html | truncate: 80 }}</p>
            {%- endif -%}
            <span class="collection-link">Shop now →</span>
          </div>
        </a>
      {%- else -%}
        <!-- Default collection cards when no blocks are set -->
        <a href="/collections/bowls" class="collection-card">
          <div class="collection-card-image collection-placeholder-bg collection-placeholder-bowls">
            <div class="collection-card-overlay"></div>
          </div>
          <div class="collection-card-content">
            <h3>Bowls</h3>
            <p>Ocean blues, warm sands, and deep forest greens</p>
            <span class="collection-link">Shop now →</span>
          </div>
        </a>
        <a href="/collections/mugs" class="collection-card">
          <div class="collection-card-image collection-placeholder-bg collection-placeholder-mugs">
            <div class="collection-card-overlay"></div>
          </div>
          <div class="collection-card-content">
            <h3>Mugs</h3>
            <p>Start every morning with something beautiful</p>
            <span class="collection-link">Shop now →</span>
          </div>
        </a>
        <a href="/collections/objects" class="collection-card">
          <div class="collection-card-image collection-placeholder-bg collection-placeholder-objects">
            <div class="collection-card-overlay"></div>
          </div>
          <div class="collection-card-content">
            <h3>Objects & Vases</h3>
            <p>Sculptural pieces to anchor any space</p>
            <span class="collection-link">Shop now →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the full range of handcrafted ceramics"
    }
  ],
  "presets": [
    {
      "name": "Featured Collections"
    }
  ]
}
{% endschema %}
